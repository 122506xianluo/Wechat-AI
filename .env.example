# OpenAI-compatible Chat Completions endpoint.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-name

# Optional transcription endpoint; empty base/key reuse LLM. Model is required.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Optional remote embeddings. Model must be configured separately.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
